# 当前运行环境：development / test / production
NODE_ENV=development

# 后端 HTTP 服务监听端口
PORT=3001

# 后端对外访问地址，用于日志、OpenAPI 和回调 URL 生成
API_PUBLIC_URL=http://localhost:3001

# 前端 Web 地址，用于邮件验证、找回密码等跳转链接
WEB_PUBLIC_URL=http://localhost:3000

# 允许访问后端的前端 Origin 白名单，多个值用英文逗号分隔
CORS_ORIGINS=http://localhost:3000,https://counterattack-offer.vercel.app

# PostgreSQL 连接串，本地默认连接 backend/docker-compose.yml 中的数据库
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/counterattack_offer?schema=public

# Swagger/OpenAPI 文档路径，最终地址为 /docs
SWAGGER_PATH=docs

# Access Token 签名密钥，至少 32 字符，本地也建议替换
JWT_ACCESS_SECRET=replace-with-long-random-access-secret

# Refresh Token 签名密钥，至少 32 字符，必须与 Access Token 密钥不同
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret

# Access Token 有效期，单位秒；900 表示 15 分钟
ACCESS_TOKEN_TTL_SECONDS=900

# Refresh Token 有效期，单位天
REFRESH_TOKEN_TTL_DAYS=30

# API Key / SMTP 密码加密主密钥，要求 32 字节明文或 base64 编码后的 32 字节
APP_KEY_ENCRYPTION_SECRET=base64-32-byte-secret

# 空库首次启动时创建的默认管理员邮箱；数据库已有用户时不会使用
ADMIN_EMAIL=admin@nixioffer.com

# 空库首次启动时创建的默认管理员密码；首次登录后请立即修改
ADMIN_PASSWORD=Admin@123
