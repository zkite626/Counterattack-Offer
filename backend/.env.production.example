# 当前运行环境：production
NODE_ENV=production

# 后端 HTTP 服务监听端口
PORT=3001

# 后端公开地址
API_PUBLIC_URL=https://api.offer.example.com

# 前端 Web 地址，用于邮件验证、找回密码等跳转链接
WEB_PUBLIC_URL=https://offer.example.com

# 允许访问后端的前端 Origin 白名单，多个值用英文逗号分隔
CORS_ORIGINS=https://offer.example.com,https://counterattack-offer.vercel.app

# PostgreSQL 连接串，生产环境请替换为真实账号和密码
DATABASE_URL=postgresql://counterattack_offer_app:replace-with-strong-password@127.0.0.1:5432/counterattack_offer?schema=public

# Swagger/OpenAPI 文档路径，线上通常仍保持 /docs 或通过网关限制访问
SWAGGER_PATH=docs

# Access Token 签名密钥，至少 32 字符
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters

# Refresh Token 签名密钥，至少 32 字符，必须与 Access Token 密钥不同
JWT_REFRESH_SECRET=replace-with-another-32-random-characters

# Access Token 有效期，单位秒；900 表示 15 分钟
ACCESS_TOKEN_TTL_SECONDS=900

# Refresh Token 有效期，单位天
REFRESH_TOKEN_TTL_DAYS=30

# API Key / SMTP 密码加密主密钥，要求 32 字节明文或 base64 编码后的 32 字节
APP_KEY_ENCRYPTION_SECRET=replace-with-base64-32-byte-secret

# 空库首次启动时创建的默认管理员邮箱；数据库已有用户时不会使用
ADMIN_EMAIL=admin@nixioffer.com

# 空库首次启动时创建的默认管理员密码；首次登录后请立即修改
ADMIN_PASSWORD=Admin@123
