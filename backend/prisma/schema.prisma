generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT @map("student")
  ADMIN   @map("admin")
}

enum UserStatus {
  ACTIVE        @map("active")
  PENDING_EMAIL @map("pending_email")
  DISABLED      @map("disabled")
  DELETED       @map("deleted")
}

enum ClientType {
  WEB    @map("web")
  MOBILE @map("mobile")
}

enum MailType {
  VERIFY_EMAIL     @map("verify_email")
  RESET_PASSWORD   @map("reset_password")
  WELCOME          @map("welcome")
  SECURITY_NOTICE  @map("security_notice")
  PASSWORD_CHANGED @map("password_changed")
  TEST             @map("test")
}

enum MailStatus {
  QUEUED @map("queued")
  SENT   @map("sent")
  FAILED @map("failed")
}

enum TestStatus {
  SUCCESS @map("success")
  FAILED  @map("failed")
}

enum AIModelScope {
  USER   @map("user")
  GLOBAL @map("global")
}

enum AICallStatus {
  SUCCESS @map("success")
  FAILED  @map("failed")
}

enum CareerFlowStatus {
  DRAFT     @map("draft")
  RUNNING   @map("running")
  COMPLETED @map("completed")
  FAILED    @map("failed")
}

model User {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                   String                   @unique @db.VarChar(255)
  emailVerifiedAt         DateTime?                @map("email_verified_at") @db.Timestamptz(6)
  passwordHash            String                   @map("password_hash") @db.VarChar(255)
  name                    String                   @db.VarChar(100)
  avatarUrl               String?                  @map("avatar_url")
  role                    UserRole                 @default(STUDENT)
  status                  UserStatus               @default(PENDING_EMAIL)
  lastLoginAt             DateTime?                @map("last_login_at") @db.Timestamptz(6)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  mailEvents              MailEvent[]
  smtpSettings            SmtpSetting[]            @relation("SmtpSettingUpdater")
  auditLogs               AuditLog[]               @relation("AuditActor")
  appSettings             AppSetting[]             @relation("AppSettingUpdater")
  aiModelConfigs          AIModelConfig[]          @relation("AIModelOwner")
  createdAIModelConfigs   AIModelConfig[]          @relation("AIModelCreator")
  aiCallLogs              AICallLog[]
  studentProfile          StudentProfile?
  experiences             Experience[]
  careerFlowRuns          CareerFlowRun[]
  resumes                 Resume[]
  resumeVersions          ResumeVersion[]          @relation("ResumeVersionCreator")

  @@index([role])
  @@index([status])
  @@map("users")
}

model AIModelConfig {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope             AIModelScope
  ownerUserId       String?            @map("owner_user_id") @db.Uuid
  displayName       String             @map("display_name") @db.VarChar(120)
  provider          String             @db.VarChar(60)
  baseUrl           String             @map("base_url")
  model             String             @db.VarChar(120)
  encryptedApiKey   String             @map("encrypted_api_key")
  apiKeyHint        String             @map("api_key_hint") @db.VarChar(80)
  apiKeyFingerprint String             @map("api_key_fingerprint") @db.VarChar(128)
  temperature       Decimal?           @db.Decimal(4, 2)
  maxTokens         Int?               @map("max_tokens")
  isDefault         Boolean            @default(false) @map("is_default")
  isEnabled         Boolean            @default(true) @map("is_enabled")
  lastTestedAt      DateTime?          @map("last_tested_at") @db.Timestamptz(6)
  lastTestStatus    TestStatus?        @map("last_test_status")
  createdBy         String?            @map("created_by") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  ownerUser         User?              @relation("AIModelOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdByUser     User?              @relation("AIModelCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  aiCallLogs        AICallLog[]
  careerFlowResults CareerFlowResult[]

  @@index([scope])
  @@index([ownerUserId])
  @@index([createdBy])
  @@index([isEnabled])
  @@index([scope, isDefault])
  @@index([apiKeyFingerprint])
  @@map("ai_model_configs")
}

model StudentProfile {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String       @unique @map("user_id") @db.Uuid
  schoolType          String       @default("") @map("school_type") @db.VarChar(120)
  major               String       @default("") @db.VarChar(120)
  grade               String       @default("") @db.VarChar(80)
  targetCities        String[]     @default([]) @map("target_cities")
  targetRoles         String[]     @default([]) @map("target_roles")
  educationBackground String       @default("") @map("education_background")
  skills              String[]     @default([])
  weaknesses          String[]     @default([])
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiences         Experience[]

  @@index([userId])
  @@map("student_profiles")
}

model Experience {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  profileId  String         @map("profile_id") @db.Uuid
  rawContent String         @map("raw_content")
  type       String         @default("other") @db.VarChar(80)
  sortOrder  Int            @default(0) @map("sort_order")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile    StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([profileId])
  @@index([userId, sortOrder])
  @@map("experiences")
}

model CareerFlowRun {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  targetRole     String?            @map("target_role") @db.VarChar(160)
  jobDescription String?            @map("job_description")
  status         CareerFlowStatus   @default(DRAFT)
  currentStep    String             @default("profile") @map("current_step") @db.VarChar(80)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  results        CareerFlowResult[]
  resumes        Resume[]

  @@index([userId])
  @@index([status])
  @@index([updatedAt])
  @@map("career_flow_runs")
}

model CareerFlowResult {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId         String         @map("run_id") @db.Uuid
  step          String         @db.VarChar(80)
  inputSnapshot Json           @map("input_snapshot")
  result        Json
  modelConfigId String?        @map("model_config_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  run           CareerFlowRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  modelConfig   AIModelConfig? @relation(fields: [modelConfigId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([modelConfigId])
  @@index([step])
  @@index([createdAt])
  @@map("career_flow_results")
}

model Resume {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  title       String          @db.VarChar(160)
  templateId  String          @default("classic") @map("template_id") @db.VarChar(80)
  theme       Json            @default("{}")
  content     Json
  sourceRunId String?         @map("source_run_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceRun   CareerFlowRun?  @relation(fields: [sourceRunId], references: [id], onDelete: SetNull)
  versions    ResumeVersion[]

  @@index([userId])
  @@index([sourceRunId])
  @@index([updatedAt])
  @@map("resumes")
}

model ResumeVersion {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resumeId  String   @map("resume_id") @db.Uuid
  versionNo Int      @map("version_no")
  content   Json
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  creator   User     @relation("ResumeVersionCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@unique([resumeId, versionNo])
  @@index([resumeId])
  @@index([createdBy])
  @@map("resume_versions")
}

model AICallLog {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String         @map("user_id") @db.Uuid
  modelConfigId    String?        @map("model_config_id") @db.Uuid
  module           String         @db.VarChar(80)
  provider         String         @db.VarChar(60)
  model            String         @db.VarChar(120)
  status           AICallStatus
  promptTokens     Int?           @map("prompt_tokens")
  completionTokens Int?           @map("completion_tokens")
  latencyMs        Int            @map("latency_ms")
  errorCode        String?        @map("error_code") @db.VarChar(120)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelConfig      AIModelConfig? @relation(fields: [modelConfigId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([modelConfigId])
  @@index([module])
  @@index([status])
  @@index([createdAt])
  @@map("ai_call_logs")
}

model RefreshToken {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  tokenHash  String     @map("token_hash") @db.VarChar(255)
  clientType ClientType @map("client_type")
  deviceName String?    @map("device_name") @db.VarChar(120)
  ipAddress  String?    @map("ip_address") @db.Inet
  userAgent  String?    @map("user_agent")
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime?  @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  email     String    @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model SmtpSetting {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  host              String      @db.VarChar(255)
  port              Int
  secure            Boolean
  username          String      @db.VarChar(255)
  encryptedPassword String      @map("encrypted_password")
  fromName          String      @map("from_name") @db.VarChar(120)
  fromEmail         String      @map("from_email") @db.VarChar(255)
  isEnabled         Boolean     @default(true) @map("is_enabled")
  lastTestedAt      DateTime?   @map("last_tested_at") @db.Timestamptz(6)
  lastTestStatus    TestStatus? @map("last_test_status")
  updatedBy         String?     @map("updated_by") @db.Uuid
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedByUser     User?       @relation("SmtpSettingUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([updatedBy])
  @@map("smtp_settings")
}

model MailEvent {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?    @map("user_id") @db.Uuid
  type         MailType
  toEmail      String     @map("to_email") @db.VarChar(255)
  subject      String     @db.VarChar(255)
  status       MailStatus
  errorMessage String?    @map("error_message")
  sentAt       DateTime?  @map("sent_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("mail_events")
}

model AppSetting {
  key           String   @id @db.VarChar(100)
  value         Json
  isSecret      Boolean  @default(false) @map("is_secret")
  updatedBy     String?  @map("updated_by") @db.Uuid
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedByUser User?    @relation("AppSettingUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([updatedBy])
  @@map("app_settings")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(120)
  targetType  String   @map("target_type") @db.VarChar(120)
  targetId    String?  @map("target_id") @db.Uuid
  metadata    Json     @default("{}")
  ipAddress   String?  @map("ip_address") @db.Inet
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actorUser   User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}
