  "info": {
    "title": "逆袭Offer API",
    "description": "逆袭Offer 独立后端 API v1 契约",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthDataDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "database": {
            "type": "string",
            "example": "ok"
          },
          "uptime": {
            "type": "number",
            "description": "服务进程运行秒数",
            "example": 12345
          }
        },
        "required": [
          "status",
          "database",
          "uptime"
        ]
      },
      "HealthSuccessResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "$ref": "#/components/schemas/HealthDataDto"
          },
          "requestId": {
            "type": "string",
            "example": "req_018fdbb0-8f62-7c4e-9c49"
          }
        },
        "required": [
          "success",
          "data"
        ]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "稳定错误码，供前端和移动端做分支处理",
            "example": "VALIDATION_ERROR"
          },
          "message": {
            "type": "string",
            "description": "面向用户或开发者的错误描述",
            "example": "参数校验失败"
          },
          "details": {
            "type": "object",
            "description": "字段级校验错误，key 为字段名，value 为错误列表",
            "example": {
              "email": [
                "邮箱格式不正确"
              ]
            }
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "ApiFailureResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "$ref": "#/components/schemas/ApiErrorDto"
          },
          "requestId": {
            "type": "string",
            "example": "req_018fdbb0-8f62-7c4e-9c49"
          }
        },
        "required": [
          "success",
          "error"
        ]
      }
    }
  }
}
